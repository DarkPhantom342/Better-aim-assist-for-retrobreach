local ScanRoots = {Workspace, ReplicatedStorage, ServerStorage, Lighting, unpack(Players:GetPlayers())}

local function findItem()
    for _, Root in ipairs(ScanRoots) do
        if not Root or not Root:IsDescendantOf(game) then continue end
        for _, Desc in ipairs(Root:GetDescendants()) do
            if Desc.Name == TARGET_NAME and (Desc:IsA("BasePart") or Desc:IsA("Model") or Desc:IsA("Tool")) then
                return Desc
            end
        end
    end
    return nil
end

local function GetPos(obj)
    if obj:IsA("Model") and obj.PrimaryPart then
        return obj.PrimaryPart.Position
    elseif obj:IsA("Model") then
        return obj:GetBoundingBox().Position
    else
        return obj.Position
    end
end

local function PressKey(key)
    pcall(function() UIS:SendKeyEvent(true, key, false, game) end)
    task.wait(0.12)
    pcall(function() UIS:SendKeyEvent(false, key, false, game) end)
end

local function run268Logic()
    local Character = LocalPlayer.Character
    if not Character or not Character:FindFirstChild("HumanoidRootPart") then return end
    
    local HRP = Character.HumanoidRootPart
    local OriginalCFrame = HRP.CFrame
    local item = findItem()
    if not item then return end

    local TargetPos = GetPos(item)
    HRP.CFrame = CFrame.new(TargetPos + Vector3.new(REACH_DISTANCE, 1.5, 0))
    task.wait(0.8)

    for i = 1, TIMES_TO_PRESS_E do
        PressKey(INTERACT_KEY)
        task.wait(DELAY_BETWEEN_PRESSES)
    end

    task.wait(0.4)
    HRP.CFrame = OriginalCFrame
end

local function CheckSpawnAndRun()
    if AUTO_RAN then return end
    if not LocalPlayer.Team then return end

    local TeamName = LocalPlayer.Team.Name:upper()
    local IsClassD = TeamName == "CLASS-D" or TeamName:find("CLASS%-D")

    if IsClassD then
        AUTO_RAN = true
        task.wait(2)
        run268Logic()
    end
end

