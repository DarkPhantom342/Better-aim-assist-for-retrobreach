local function findItem()
    for _, descendant in ipairs(workspace:GetDescendants()) do
        if descendant:IsA("BasePart") and descendant.Name == TARGET_NAME then
            return descendant
        end
    end
    return nil
end

local function run268Logic()
    local Character = v5.Character
    if not Character or not Character:FindFirstChild("HumanoidRootPart") then return end
    
    local HRP = Character.HumanoidRootPart
    local OriginalPosition = HRP.Position
    
    local item = findItem()
    if not item then
        return
    end
    
    local itemPos = item.Position
    HRP.CFrame = CFrame.new(itemPos + Vector3.new(REACH_DISTANCE, 0, 0))
    
    task.wait(0.5)
    
    for i = 1, TIMES_TO_PRESS_E do
        v3:SendKeyEvent(true, INTERACT_KEY, false, game)
        task.wait(0.05)
        v3:SendKeyEvent(false, INTERACT_KEY, false, game)
        task.wait(DELAY_BETWEEN_PRESSES)
    end
    
    if OriginalPosition then
        HRP.CFrame = CFrame.new(OriginalPosition)
    end
end

